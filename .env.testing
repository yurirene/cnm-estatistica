APP_NAME="CNM Estatistica Testing"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array

TELESCOPE_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000

SICOM_API_TOKEN=testing-sicom-token
EXECUTIVA_API_TOKEN=testing-executiva-token
